<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pin transitive package versions to the values declared below.
         Required so that security pins (e.g. OpenTelemetry.Api 1.15.3 for GHSA-g94r-2vxg-569j)
         take effect for packages we don't reference directly. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Microsoft Agent Framework — core packages on 1.23.0 (stable), bumped from 1.17.0 (2026-10).
         1.17→1.23 needed NO source changes: a trial build had 0 errors on net8/9/10 and the same warning set as 1.17.
         The runtime-relevant changes are in tool approval (1.18 #7474 bounds the auto-approval loop with
         MaxAutoApprovalIterations; 1.22/1.23 #8375/#8641 bind and then enforce approval responses on replay;
         1.23 #8403 closes an invoke path that bypassed approval) — Gatekeeper's approval samples are re-verified
         live against them. Foundry and A2A are still preview-only, pinned to the matching 1.23.0 preview.
         History of the previous bump (1.13.0 → 1.17.0, S4), kept for the record:
         Microsoft.Agents.AI.Foundry has no stable 1.17.0 yet (published preview-only), so it's pinned to
         the matching 1.17.0-preview and is referenced only by the SAMPLES (the
         AgentEval.MafEvalFoundryAlongsideLocal standalone + the AgentEval.Samples H12/H13 benchmarks) —
         the shipping libraries stay provider-agnostic. Stable core 1.17.0 satisfies the preview's
         Microsoft.Agents.AI dependency (a stable version outranks a same-version prerelease).
         Unlike the 1.12→1.13 bump, 1.13→1.17 DID require source changes — three of them:
         (1) AgentHarnessOptions.DisableFileAccess removed; file access is now opt-in via FileAccessStore
             ("When null (the default), no provider is added and the agent has no file access tools"), so the
             Harness samples drop the flag and leave FileAccessStore unset — same effective capability set;
         (2) ToolApprovalAgentOptions.AutoApprovalRules changed from Func<FunctionCallContent, ValueTask<bool>>
             to Func<ToolAutoApprovalRuleContext, ValueTask<bool>> (1.14.0, PR #7107). The context is a strict
             superset, so AgentEvalToolApprovalExtensions unwraps it non-lossily;
         (3) UseToolApproval / ToolApprovalAgentOptions graduated from [Experimental("MAAI001")] to stable in
             1.14.0, which is why AgentEval's own AEGK001 experimental marker and every MAAI001 suppression
             around the approval bridge were removed.
         Microsoft.Agents.AI.Harness reaches its first STABLE release at 1.17.0 (was preview-only at 1.13.0). -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.23.0" />
    <PackageVersion Include="Microsoft.Agents.AI.A2A" Version="1.23.0-preview.260928.1" /><!-- preview-only; A2A boundary sample + tests -->
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.23.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.23.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows.Generators" Version="1.23.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="1.23.0-preview.260928.1" /><!-- preview-only; sample-only -->
    <PackageVersion Include="Microsoft.Agents.AI.Harness" Version="1.23.0" /><!-- stable since 1.17.0 (S4); was preview-only at 1.13.0 -->
    <PackageVersion Include="Azure.AI.Projects" Version="3.0.0-beta.3" /><!-- required by Microsoft.Agents.AI.Foundry 1.23.0-preview.260928.1, whose nuspec declares exactly 3.0.0-beta.3 (a major beta with breaking changes; referenced only by the Foundry SAMPLES, which build against it) -->
    <!-- S1: AGENT-HOOKS-0.1 interceptor contract (MIT, zero dependencies, lib/net8.0 + native FFI for
         win-x64/linux-x64/osx-x64/osx-arm64). Used ONLY by src/AgentEval.MAF.AgentHooks; deliberately not
         referenced by AgentEval.MAF so the core package never takes an alpha/native dependency. -->
    <PackageVersion Include="ResponsibleAI.AgentHooks" Version="0.1.0-alpha.5" />
    <!-- Microsoft's AgentHooks HOST (alpha, shipped with MAF since 1.19). TESTS and SAMPLES ONLY: it proves that
         GatekeeperInterceptor runs inside MAF's own host. It depends on the same ResponsibleAI.AgentHooks
         0.1.0-alpha.5 pinned above, so there is no diamond. No shipped package references it. -->
    <PackageVersion Include="Microsoft.Agents.AI.AgentHooks" Version="1.23.0-alpha.260928.1" />
    
    <!-- Microsoft Extensions AI — 10.10.0 is the floor Microsoft.Agents.AI 1.23.0 requires.
         Microsoft.Extensions.AI.OpenAI is pinned to 10.10.1, NOT 10.10.0: Microsoft.Agents.AI.OpenAI 1.23.0 and the
         Foundry preview declare >= 10.10.1, yet with transitive pinning a 10.10.0 pin restores WITHOUT a warning, and
         MAF #8730 reports that 10.10.0 throws TypeLoadException on every Responses call that carries a tool. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="10.10.0" />

    <!-- Azure -->
    <!-- SEC-13: Azure.AI.OpenAI is a direct ref of AgentEval.Cli (packed/published as a global
         dotnet tool), so a -beta dependency risks yank/unlist and API churn. It is pinned to beta
         deliberately: the only stable 2.x release on NuGet is 2.0.0 (Nov 2024), which predates the
         API surface used by the Microsoft.Agents.AI 1.17+ stack and AzureChatAgentFactory — there is
         no recent GA to move to. Mitigations: (1) the CLI itself ships on the -prerelease channel,
         so a beta dependency is in-band; (2) the version is centrally pinned here (CPM) so it cannot
         float. ACTION: upgrade to a stable Azure.AI.OpenAI 2.x as soon as one ships (tracked, vNext). -->
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.8.0-beta.1" />
    <PackageVersion Include="Azure.Identity" Version="1.18.0" />

    <!-- Copilot Studio live connector (Track 1 of the Copilot Studio integration plan).
         1.3.171-beta is the actual latest version published to nuget.org (verified against the local package
         cache + decompiled source); the plan doc's "v1.6.150" reference does not exist on nuget.org and was a
         doc error. Microsoft.Agents.Core is CopilotStudio.Client's own required dependency — pinned to the exact
         version its nuspec declares — because CopilotStudioChatClient.cs consumes its Discovery/Models/IActivity
         types directly, not just incidentally through CopilotStudio.Client. -->
    <PackageVersion Include="Microsoft.Agents.CopilotStudio.Client" Version="1.3.171-beta" />
    <PackageVersion Include="Microsoft.Agents.Core" Version="1.3.171-beta" />
    <!-- MSAL device-code auth + the officially-recommended cross-platform persisted token cache
         (DPAPI on Windows / Keychain on macOS / libsecret on Linux) — see CopilotStudioTokenProvider.cs. -->
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.89.0" /><!-- floor raised to 4.89.0 by the Foundry 1.23 preview chain (Azure.Identity/Azure.Core); central pins are solution-wide, so the Copilot Studio connector moves with it -->
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.89.0" />
    <!-- IHttpClientFactory — required by the CopilotClient constructor. 10.0.8 (not the 9.0.1 floor
         CopilotStudio.Client's own nuspec declares) to stay on the same 10.x line as the other
         Microsoft.Extensions.* pins below. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.8" />

    <!-- Core -->
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.12" /><!-- floor raised by Microsoft.Extensions.AI 10.10.0 (required by MAF 1.23.0) -->
    <PackageVersion Include="System.Memory.Data" Version="10.0.10" /><!-- floor raised by Azure.Core (transitive via Azure.AI.Projects 3.0.0-beta.3, required by Microsoft.Agents.AI.Foundry 1.23.0-preview) -->
    <!-- Security: originally pinned to 1.15.3, the patch that resolves GHSA-g94r-2vxg-569j (transitive via MAF).
         Microsoft.Agents.AI.Workflows 1.23.0 itself declares OpenTelemetry.Api >= 1.18.0, which is past that patch,
         so the pin now follows MAF's floor; it is kept so the transitive version cannot fall back below the fix. -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.18.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.3" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <!-- Abstractions packages target netstandard2.0/net8.0 — safe for net8/9/10 TFMs.
         10.0.3 required transitively by Azure.Identity 1.18.0; raised further to 10.0.8 — the floor
         Microsoft.Extensions.Http 10.0.8 imposes via Microsoft.Extensions.Logging 10.0.8 (Copilot Studio
         live connector's IHttpClientFactory wiring). -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" /><!-- floor raised by Azure.Core (transitive via Azure.AI.Projects 3.0.0-beta.3, required by Microsoft.Agents.AI.Foundry 1.23.0-preview) -->
    
    <!-- PDF Generation -->
    <PackageVersion Include="PdfSharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="QuestPDF" Version="2026.2.4" />
    
    <!-- Model Context Protocol (.NET SDK, Apache-2.0) — used ONLY by samples/AgentEval.PartnerDeskDemo,
         which hosts a real stdio MCP server in a child process and connects to it as an MCP client so the
         demo's third-party boundary is a genuine protocol boundary rather than an in-process call.
         ModelContextProtocol.Core carries BOTH the client (McpClient/StdioClientTransport) and the transport-
         level server (McpServer.Create/StdioServerTransport), so the demo needs no DI-hosting package.
         The shipping libraries do NOT reference it. -->
    <PackageVersion Include="ModelContextProtocol.Core" Version="1.4.0" />

    <!-- JSON Schema -->
    <PackageVersion Include="JsonSchema.Net" Version="7.3.4" />

    <!-- Mission Control (GraphQL server — Hot Chocolate by ChilliCream, NOT Microsoft). -->
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.0.0" />

    <!-- ASP.NET test host (for WebApplicationFactory<Program>) — pinned to 10.0
         to match the Mission Control project's net10.0 TFM. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" /><!-- Deferred: upgrade to 3.x requires xunit v3 migration (tracked issue) -->
    <PackageVersion Include="coverlet.collector" Version="8.0.0" />
    <PackageVersion Include="Verify.Xunit" Version="28.8.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.7.0" /><!-- FakeTimeProvider: deterministic clock for timeout tests (test-only) -->
    <!-- PDF parser used only by test-side assertions (plan-13 T4.1b item 9).
         Lightweight (~500 KB), MIT-licensed; pulled in with PrivateAssets="all"
         in the test csproj so it doesn't leak into any shipped surface. -->
    <PackageVersion Include="PdfPig" Version="0.1.10" />
    
    <!-- SourceLink for debugging support.
         8.0.0 to 10.0.401 on 2026-09-13. CVE-2026-62900 (GHSA-23fw-v26w-5fgq, .NET information
         disclosure) lists Microsoft.Build.Tasks.Git 8.0.0 as vulnerable with NO patch on that
         line, and SourceLink.GitHub 8.0.0 pulls exactly that transitively. The advisory was
         published after main last went green, so CI failed on a commit that changed no
         dependency at all: the vulnerable-package listing reads the LIVE advisory database,
         which is the point of it. 10.0.401 is above every patched threshold the advisory names
         (10.0.111 and 10.0.303). PrivateAssets="All" everywhere it is referenced, so this is
         build-time only and ships in no package.

         NOTE FOR THE NEXT EDITOR: a double hyphen is ILLEGAL inside an XML comment. Writing one
         here silently invalidates this whole file, every project loses central package
         management at once, and the failure surfaces as NU1015 "no version specified" across
         dozens of unrelated packages, which reads like a dependency problem and is not one. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>
</Project>
