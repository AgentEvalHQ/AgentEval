{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.dev/schemas/requirements/1/catalogue.schema.json",
  "title": "AgentEval requirement catalogue 1.0 (external to AEF)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requirements"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requirements": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/requirement" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 256 },
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["lane", "metric", "path"],
      "properties": {
        "lane": { "$ref": "#/$defs/text" },
        "metric": { "$ref": "#/$defs/text" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "suiteRef": { "$ref": "#/$defs/text" },
        "suiteDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "deployment": { "$ref": "#/$defs/text" }
      }
    },
    "acceptance": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "operator", "value"],
          "properties": {
            "kind": { "const": "threshold" },
            "operator": { "enum": [">", ">=", "<", "<=", "==", "!="] },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "states"],
          "properties": {
            "kind": { "const": "state" },
            "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["passed", "failed", "warn", "scored"] } }
          }
        }
      ]
    },
    "aggregation": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "missing"],
          "properties": { "kind": { "enum": ["all", "any"] }, "missing": { "const": "not_measured" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "minimum", "missing"],
          "properties": {
            "kind": { "const": "fraction" }, "minimum": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "missing": { "const": "not_measured" }
          }
        }
      ]
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "selector", "acceptance", "aggregation", "freshnessSeconds"],
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "description": { "type": "string", "maxLength": 4096 },
        "selector": { "$ref": "#/$defs/selector" },
        "acceptance": { "$ref": "#/$defs/acceptance" },
        "aggregation": { "$ref": "#/$defs/aggregation" },
        "freshnessSeconds": { "type": "integer", "minimum": 1, "maximum": 3155760000 },
        "allowEffectiveOverrides": { "type": "boolean" }
      }
    }
  }
}
