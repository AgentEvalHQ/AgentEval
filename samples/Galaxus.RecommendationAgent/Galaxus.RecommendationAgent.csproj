<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>

    <!-- Pure MAF + Azure OpenAI demo (no AgentEval dependency).
         Versions resolve from Directory.Packages.props (Central Package Management):
         NO Version= attributes here (NU1008), and a package absent from that file
         fails restore with NU1010. Every reference below was checked against it. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <!-- MANDATORY, not transitive (MAF 1.17.0). Executor.ConfigureProtocol(ProtocolBuilder) is
         abstract and this source generator emits it; without the reference every custom
         Executor in Workflows/ fails with CS0534. Verified by removing it. -->
    <PackageReference Include="Microsoft.Agents.AI.Workflows.Generators" />
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="System.Memory.Data" />
    <!-- Brute-force cosine over the product index. Already pinned centrally (10.0.9). -->
    <PackageReference Include="System.Numerics.Tensors" />
    <!-- Security: transitive pin (GHSA-g94r-2vxg-569j) -->
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

  <!-- The two committed vector assets (design §D.4 / §G). Generated 2026-09-05 by running
       this project with the "rebuild-embeddings" switch and the embedding-model override
       pointed at text-embedding-3-small (the exact command line is in MEASUREMENT_STATUS §16;
       XML comments cannot carry a double hyphen, so it is not repeated here).
       170 live calls, 13 383 prompt tokens, ≈ USD 0.00027. Real text-embedding-3-small
       vectors: 99 product documents + 71 query texts, 1536 dims, template stamp v2.

       These two lines and the two files land in the SAME commit on purpose — an
       EmbeddedResource pointing at a missing file is a hard build error (MSB3030), which
       is why they were absent until the assets existed.

       ⚠ Adding them does NOT change how the demo retrieves. The default embedding source
       on every demo and eval path is still ConceptEmbeddingSource (authored concept
       vectors, deterministic, no key, no network) — see MEASUREMENT_STATUS §16. The
       committed assets are the real-vector path that PrecomputedEmbeddingSource loads and
       that the AuthoredQueryPhraseRetrievability control measures; nothing else reads them
       today, and that is stated rather than implied. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\catalogue.embeddings.json" />
    <EmbeddedResource Include="Data\queries.embeddings.json" />
  </ItemGroup>

</Project>
