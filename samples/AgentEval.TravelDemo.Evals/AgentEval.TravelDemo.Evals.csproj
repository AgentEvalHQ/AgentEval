<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>

    <!-- Standalone eval project — intentionally NOT in AgentEval.sln -->
    <!-- AgentEval evaluation code decoupled from the MAF demo project -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the demo project — agents and workflow factories live there -->
    <ProjectReference Include="../AgentEval.TravelDemo/AgentEval.TravelDemo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AgentEval NuGet package for assertions and metrics.
         T2.9 (v1.1): bumped from 0.8.1-beta -> 0.10.1-beta to pick up the v0.10.x
         IOutputStore + audit-chain v2 (canonical-JSON re-hash) surface. The local
         EvalResultStore (samples/AgentEval.TravelDemo.Evals/EvalResultStore.cs)
         intentionally stays — it persists demo-specific hypothesis-comparison
         snapshots (EvalSnapshot / StochasticSnapshot with Architecture, LlmScore,
         BookFlightCount, ToolCallCount etc.) that don't fit the canonical
         ScenarioResult shape IOutputStore enforces. The two stores serve
         different purposes and coexist by design. -->
    <PackageReference Include="AgentEval" Version="0.10.1-beta" />

    <!-- MAF + Azure packages (must match AgentEval.TravelDemo to avoid version conflicts) -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.3.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.3.0" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.8.0-beta.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.5.0" />
    <PackageReference Include="System.Memory.Data" Version="10.0.3" />
    <!-- Security: transitive pin (GHSA-g94r-2vxg-569j) -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
  </ItemGroup>

</Project>
