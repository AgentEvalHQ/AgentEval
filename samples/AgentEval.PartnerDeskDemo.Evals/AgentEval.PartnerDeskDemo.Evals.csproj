<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>AgentEval.PartnerDeskDemo.Evals</RootNamespace>
    <AssemblyName>AgentEval.PartnerDeskDemo.Evals</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The demo under evaluation. Reusing its runner, tools, MCP boundary, gates, recorded-trajectory types
         and deterministic oracle means the eval measures exactly what the demo does — no second implementation
         of the scenario to drift. The ProjectReference also lands the demo's binary next to this one so the
         real PartnerIntel MCP server can be started as a child process. -->
    <ProjectReference Include="..\AgentEval.PartnerDeskDemo\AgentEval.PartnerDeskDemo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Azure.AI.OpenAI" />
    <!-- Security: transitive pin (GHSA-g94r-2vxg-569j) -->
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

</Project>
