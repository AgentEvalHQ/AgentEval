<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    
    <!-- Exclude from Central Package Management - standalone consumer sample -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    
    <!-- It tests the NuGet package as an external consumer would -->
  </PropertyGroup>

  <!-- Validate the published RC as an external consumer; do not substitute a source project reference. -->
  <ItemGroup>
    <PackageReference Include="AgentEval" Version="1.0.0-rc.1" />

    <!-- Explicit versions (CPM disabled), aligned to the published RC.1 nuspec:
         MAF 1.24.0 / Microsoft.Extensions.AI 10.10.0 / OpenTelemetry.Api 1.18.0.
         Microsoft.Extensions.AI.OpenAI 10.10.1 matches this repository's provider adapter. -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.8.0-beta.1" />
    <PackageReference Include="System.Memory.Data" Version="10.0.10" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.24.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <!-- Security: explicit transitive pin (GHSA-g94r-2vxg-569j); CPM disabled in this project.
         The published RC already requires OpenTelemetry.Api 1.18.0, but a CPM-disabled consumer
         won't inherit transitive pinning — keep this explicit so the resolved version is unambiguous. -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.18.0" />
    <!-- Security servicing fix for GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7; CPM is disabled. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    
    <!-- Semantic Kernel — for SK-native agent demo -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.72.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" Version="1.72.0" />
  </ItemGroup>

</Project>
