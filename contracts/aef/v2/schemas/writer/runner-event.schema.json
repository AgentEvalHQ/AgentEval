{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.dev/aef/v2/writer/runner-event.schema.json",
  "title": "AEF v2: one line of a runner event stream",
  "description": "A runner reports a job as NDJSON events, each with a sequence number. The stream's own rules (order, one terminal event, spend within the plan) are in v2/README.md, 'The event stream'.",
  "type": "object",
  "required": ["schemaVersion", "seq", "kind", "jobId", "at"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "seq": { "description": "1 for the first event, then each event one more than the last.", "type": "integer", "minimum": 1 },
    "jobId": { "$ref": "common.schema.json#/$defs/id" },
    "at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "planId", "runnerId"],
      "properties": {
        "schemaVersion": true, "seq": true, "jobId": true, "at": true,
        "kind": { "const": "job.accepted" },
        "planId": { "$ref": "common.schema.json#/$defs/id" },
        "runnerId": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cases", "usdLow", "usdHigh"],
      "properties": {
        "schemaVersion": true, "seq": true, "jobId": true, "at": true,
        "kind": { "const": "plan.estimated" },
        "cases": { "type": "integer", "minimum": 0 },
        "usdLow": { "type": "number", "minimum": 0 },
        "usdHigh": { "type": "number", "minimum": 0 },
        "priceTable": { "type": "string", "maxLength": 64 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "spentUsd"],
      "properties": {
        "schemaVersion": true, "seq": true, "jobId": true, "at": true,
        "kind": { "const": "spend.updated" },
        "spentUsd": { "description": "Total spent so far: never decreases.", "type": "number", "minimum": 0 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "caseId", "state"],
      "properties": {
        "schemaVersion": true, "seq": true, "jobId": true, "at": true,
        "kind": { "const": "case.completed" },
        "caseId": { "allOf": [ { "$ref": "common.schema.json#/$defs/text" } ], "minLength": 1, "maxLength": 256 },
        "state": { "$ref": "common.schema.json#/$defs/state" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lane", "status"],
      "properties": {
        "schemaVersion": true, "seq": true, "jobId": true, "at": true,
        "kind": { "const": "lane.completed" },
        "lane": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "enum": ["passed", "failed", "not_measured", "incomparable"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runId", "runHash"],
      "properties": {
        "schemaVersion": true, "seq": true, "jobId": true, "at": true,
        "kind": { "const": "evidence.produced" },
        "runId": { "$ref": "common.schema.json#/$defs/id" },
        "runHash": { "description": "The sealed run's run hash.", "$ref": "common.schema.json#/$defs/sha256Hex" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "schemaVersion": true, "seq": true, "jobId": true, "at": true,
        "kind": { "const": "job.cancelled" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "schemaVersion": true, "seq": true, "jobId": true, "at": true,
        "kind": { "const": "job.failed" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "limit": { "description": "Set when the runner stopped at a plan limit.", "enum": ["maxUsd", "cases", "timeout"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runs"],
      "properties": {
        "schemaVersion": true, "seq": true, "jobId": true, "at": true,
        "kind": { "const": "job.sealed" },
        "runs": { "description": "Every run the job produced, sealed.", "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/id" } }
      }
    }
  ]
}
