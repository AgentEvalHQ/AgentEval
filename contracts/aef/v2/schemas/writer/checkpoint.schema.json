{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.dev/aef/v2/writer/checkpoint.schema.json",
  "title": "AEF v2: checkpoint manifest",
  "description": "A release decision over several evidence lanes for one exact subject version: the lanes and their rules, the exact runs each lane used, the state, and (once decided) the outcome. See v2/README.md, 'Checkpoints'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checkpointId", "subject", "lanes", "state"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "checkpointId": { "$ref": "common.schema.json#/$defs/id" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "version"],
      "properties": {
        "ref": { "$ref": "common.schema.json#/$defs/ref" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "subject": {
      "description": "The exact version decided on. 'latest' is resolved before anything runs, and recorded: resolvedFrom says what was asked, version what it resolved to.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "version"],
      "properties": {
        "ref": { "$ref": "common.schema.json#/$defs/ref" },
        "version": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "enum": ["latest", "LATEST", "Latest"] } },
        "image": { "$ref": "common.schema.json#/$defs/sha256Uri" },
        "deployment": { "$ref": "common.schema.json#/$defs/ref" },
        "resolvedFrom": { "type": "string", "maxLength": 256 },
        "resolvedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane", "rule", "runs", "origin", "blocking"],
        "properties": {
          "lane": { "type": "string", "minLength": 1, "maxLength": 64 },
          "rule": { "$ref": "#/$defs/laneRule" },
          "requirements": { "type": "array", "maxItems": 256, "items": { "$ref": "common.schema.json#/$defs/id" } },
          "runs": { "description": "The exact sealed runs this lane used. Empty while pending.", "type": "array", "maxItems": 1024, "items": { "$ref": "common.schema.json#/$defs/id" } },
          "origin": {
            "description": "launched: run for this checkpoint; adopted:<source>: an existing sealed run that matched the exact version and the comparability requirements; pending: no run yet.",
            "type": "string",
            "pattern": "^(launched|pending|adopted:[A-Za-z0-9._:-]{1,64})$"
          },
          "blocking": { "description": "A failed blocking lane blocks the release; a failed advisory lane is reported, never ignored.", "type": "boolean" },
          "freshness": { "description": "How old this lane's evidence may be when decided (ISO 8601 duration, days or hours).", "type": "string", "pattern": "^P(?=\\d|T\\d)(\\d+D)?(T\\d+H)?$" }
        }
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "description": "The axes on which a comparison lane's runs must match their baseline (judge.modelId, judge.rubricDigest, stimulus, executionPolicy, ...).", "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 64 } }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approvedUsd": { "type": "number", "minimum": 0 },
        "spentUsd": { "type": "number", "minimum": 0 },
        "approvedBy": { "$ref": "common.schema.json#/$defs/trustedIdentity" }
      }
    },
    "state": {
      "enum": ["draft", "planned", "approved_to_spend", "running", "evidence_complete", "decided", "sealed"]
    },
    "outcome": {
      "description": "Set from state decided on; null before.",
      "anyOf": [ { "type": "null" }, { "enum": ["approved", "blocked", "inconclusive", "aborted", "expired"] } ]
    },
    "decision": {
      "description": "The decision function's output, recorded when the state became decided.",
      "$ref": "decision.schema.json"
    },
    "ext": { "$ref": "common.schema.json#/$defs/ext" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["decided", "sealed"] } }, "required": ["state"] },
      "then": { "required": ["outcome", "decision"], "properties": { "outcome": { "not": { "type": "null" } } } }
    },
    {
      "if": { "properties": { "state": { "enum": ["draft", "planned", "approved_to_spend", "running", "evidence_complete"] } }, "required": ["state"] },
      "then": { "properties": { "outcome": { "type": "null" } } }
    }
  ],
  "$defs": {
    "laneRule": {
      "description": "What kind of rule a lane applies. A family with no published pass threshold takes comparison or evidence-present, never threshold.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "metric", "op", "value"],
          "properties": {
            "kind": { "const": "threshold" },
            "metric": { "type": "string", "minLength": 1, "maxLength": 256 },
            "op": { "enum": [">=", ">", "<=", "<"] },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "max"],
          "properties": {
            "kind": { "const": "severity" },
            "max": { "description": "The worst severity allowed among the lane's required results.", "enum": ["none", "low", "medium", "high"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "baseline", "significance"],
          "properties": {
            "kind": { "const": "comparison" },
            "baseline": { "type": "string", "minLength": 1, "maxLength": 256 },
            "significance": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "groups"],
          "properties": {
            "kind": { "const": "evidence-present" },
            "groups": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}
