{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.dev/aef/v2/writer/overlay-seal.schema.json",
  "title": "AEF v2: overlays/seal-<n>.json",
  "description": "An in-toto Statement v1 over one batch of overlay events (a byte range of overlays/events.ndjson) that names the previous batch's seal: the batches form a chain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "const": "overlays/events.ndjson"
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256"
            ],
            "properties": {
              "sha256": {
                "description": "SHA-256 of the batch's bytes.",
                "$ref": "common.schema.json#/$defs/sha256Hex"
              }
            }
          }
        }
      }
    },
    "predicateType": {
      "const": "https://agenteval.dev/evidence/v2/overlay-batch"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "runId",
        "batch",
        "offset",
        "length",
        "previous"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "common.schema.json#/$defs/schemaVersion"
        },
        "runId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "batch": {
          "description": "1-based; seal-0001.json is batch 1.",
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "description": "Where the batch starts in overlays/events.ndjson, in bytes.",
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "description": "The batch's length in bytes: whole lines, each ending in \\n.",
          "type": "integer",
          "minimum": 1
        },
        "previous": {
          "description": "The previous batch's seal file and the SHA-256 of its bytes; null for batch 1.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^overlays/seal-[0-9]{4}\\.json(?!\\n)$"
                },
                "sha256": {
                  "$ref": "common.schema.json#/$defs/sha256Hex"
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "predicate": {
            "properties": {
              "batch": {
                "const": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "predicate": {
            "properties": {
              "previous": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "predicate": {
            "properties": {
              "batch": {
                "minimum": 2
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "predicate": {
            "properties": {
              "previous": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  ]
}
