{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.dev/aef/v2/reader/evidence.schema.json",
  "title": "AEF v2: one line of evidence.ndjson",
  "description": "READER (tolerant), derived from the writer schema by tools/derive_reader.py. One piece of evidence a result cites: what it is, its digest, and where to find it.",
  "type": "object",
  "required": [
    "schemaVersion",
    "evidenceId",
    "kind",
    "digest",
    "link"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "evidenceId": {
      "$ref": "common.schema.json#/$defs/evidenceId"
    },
    "kind": {
      "type": "string"
    },
    "digest": {
      "$ref": "common.schema.json#/$defs/sha256Uri"
    },
    "link": {
      "description": "Exactly one of: a blob in this run, a span in traces.otlp.jsonl, or a URI outside the run.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "blob": {
          "$ref": "common.schema.json#/$defs/sha256Uri"
        },
        "traceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "maxLength": 32
        },
        "spanId": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "maxLength": 16
        },
        "uri": {
          "$ref": "common.schema.json#/$defs/uri"
        }
      },
      "oneOf": [
        {
          "required": [
            "blob"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "traceId"
                ]
              },
              {
                "required": [
                  "spanId"
                ]
              },
              {
                "required": [
                  "uri"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "traceId",
            "spanId"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "blob"
                ]
              },
              {
                "required": [
                  "uri"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "uri"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "blob"
                ]
              },
              {
                "required": [
                  "traceId"
                ]
              },
              {
                "required": [
                  "spanId"
                ]
              }
            ]
          }
        }
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "ext": {
      "$ref": "common.schema.json#/$defs/ext"
    }
  }
}
