{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.dev/aef/v2/reader/seal.schema.json",
  "title": "AEF v2: seal.json",
  "description": "READER (tolerant), derived from the writer schema by tools/derive_reader.py. An in-toto Statement v1 over every file of the run except seal.json, attestation.dsse.json and overlays/: one subject per file, the exact bytes' SHA-256, and the run hash. See v2/README.md, 'Sealing'.",
  "type": "object",
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "description": "The file's path inside the run folder: ASCII, / separated, no . or .. segment.",
            "type": "string",
            "pattern": "^(?!\\.{1,2}(/|$))(?!.*/\\.{1,2}(/|$))[A-Za-z0-9._/-]{1,1024}(?!\\n)$"
          },
          "digest": {
            "type": "object",
            "required": [
              "sha256"
            ],
            "properties": {
              "sha256": {
                "$ref": "common.schema.json#/$defs/sha256Hex"
              }
            }
          }
        }
      }
    },
    "predicateType": {
      "const": "https://agenteval.dev/evidence/v2"
    },
    "predicate": {
      "type": "object",
      "required": [
        "schemaVersion",
        "runId",
        "runHash",
        "producer",
        "subject",
        "closedAt",
        "sealedBy"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "common.schema.json#/$defs/schemaVersion"
        },
        "runId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "runHash": {
          "description": "SHA-256 of the manifest: one line per sealed file, ordered by the UTF-8 bytes of its path, '<sha256-hex>  <size>  <path>\\n'.",
          "$ref": "common.schema.json#/$defs/sha256Hex"
        },
        "producer": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "subject": {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "$ref": "common.schema.json#/$defs/ref"
            },
            "version": {
              "type": "string",
              "maxLength": 256
            }
          }
        },
        "deployment": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "ref"
              ],
              "properties": {
                "ref": {
                  "$ref": "common.schema.json#/$defs/ref"
                }
              }
            }
          ]
        },
        "suite": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "ref",
                "version"
              ],
              "properties": {
                "ref": {
                  "$ref": "common.schema.json#/$defs/ref"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "digest": {
                  "$ref": "common.schema.json#/$defs/sha256Uri"
                }
              }
            }
          ]
        },
        "judges": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "model"
            ],
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "rubricDigest": {
                "$ref": "common.schema.json#/$defs/sha256Uri"
              }
            }
          }
        },
        "closedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "sealedBy": {
          "description": "producer: the producer wrote seal.json and a reader recomputed it; ingest: a host sealed the run when it took custody.",
          "type": "string"
        }
      }
    }
  }
}
