{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.dev/aef/1/writer/runner-event.schema.json",
  "title": "AEF 1.0: one line of a runner event stream",
  "description": "A runner reports a job as NDJSON events, each with a sequence number. The stream's own rules (order, one terminal event, spend within the plan) are in 1/README.md, 'The event stream'.",
  "type": "object",
  "required": [
    "schemaVersion",
    "seq",
    "kind",
    "jobId",
    "at"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "seq": {
      "description": "1 for the first event, then each event one more than the previous one.",
      "$ref": "common.schema.json#/$defs/integer",
      "minimum": 1
    },
    "jobId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "planId",
        "planDigest",
        "runnerId"
      ],
      "properties": {
        "schemaVersion": true,
        "seq": true,
        "jobId": true,
        "at": true,
        "kind": {
          "const": "job.accepted"
        },
        "planId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "runnerId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "ext": true,
        "planDigest": {
          "description": "SHA-256 of the exact bytes of the plan the runner accepted.",
          "$ref": "common.schema.json#/$defs/sha256Hex"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "cases",
        "usdLow",
        "usdHigh"
      ],
      "properties": {
        "schemaVersion": true,
        "seq": true,
        "jobId": true,
        "at": true,
        "kind": {
          "const": "plan.estimated"
        },
        "cases": {
          "type": "integer",
          "minimum": 0
        },
        "usdLow": {
          "type": "number",
          "minimum": 0
        },
        "usdHigh": {
          "type": "number",
          "minimum": 0
        },
        "priceTable": {
          "type": "string",
          "maxLength": 64
        },
        "ext": true
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "spentUsd"
      ],
      "properties": {
        "schemaVersion": true,
        "seq": true,
        "jobId": true,
        "at": true,
        "kind": {
          "const": "spend.updated"
        },
        "spentUsd": {
          "description": "Total spent so far: never decreases.",
          "type": "number",
          "minimum": 0
        },
        "ext": true
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "caseId",
        "state"
      ],
      "properties": {
        "schemaVersion": true,
        "seq": true,
        "jobId": true,
        "at": true,
        "kind": {
          "const": "case.completed"
        },
        "caseId": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/text"
            }
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "ext": true
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lane",
        "status"
      ],
      "properties": {
        "schemaVersion": true,
        "seq": true,
        "jobId": true,
        "at": true,
        "kind": {
          "const": "lane.completed"
        },
        "lane": {
          "$ref": "common.schema.json#/$defs/laneName"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_measured",
            "incomparable"
          ]
        },
        "ext": true
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "runId",
        "runHash"
      ],
      "properties": {
        "schemaVersion": true,
        "seq": true,
        "jobId": true,
        "at": true,
        "kind": {
          "const": "evidence.produced"
        },
        "runId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "runHash": {
          "description": "The sealed run's run hash.",
          "$ref": "common.schema.json#/$defs/sha256Hex"
        },
        "ext": true
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "schemaVersion": true,
        "seq": true,
        "jobId": true,
        "at": true,
        "kind": {
          "const": "job.cancelled"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "ext": true
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "schemaVersion": true,
        "seq": true,
        "jobId": true,
        "at": true,
        "kind": {
          "const": "job.failed"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "limit": {
          "description": "Set when the runner stopped at a plan limit.",
          "enum": [
            "maxUsd",
            "cases",
            "timeout"
          ]
        },
        "ext": true,
        "runs": {
          "description": "The runs it sealed before it stopped.",
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "runs"
      ],
      "properties": {
        "schemaVersion": true,
        "seq": true,
        "jobId": true,
        "at": true,
        "kind": {
          "const": "job.sealed"
        },
        "runs": {
          "description": "Every run the job produced, sealed.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "ext": true
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "planId",
        "planDigest",
        "runnerId",
        "reason"
      ],
      "properties": {
        "schemaVersion": true,
        "seq": true,
        "jobId": true,
        "at": true,
        "ext": true,
        "kind": {
          "const": "job.refused"
        },
        "planId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "planDigest": {
          "$ref": "common.schema.json#/$defs/sha256Hex"
        },
        "runnerId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  ]
}
