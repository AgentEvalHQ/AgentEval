<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AgentEval.Compliance.Gdpr</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentEval.Tests" />
    <InternalsVisibleTo Include="AgentEval.Rendering.PdfSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentEval.Rendering.Pdf/AgentEval.Rendering.Pdf.csproj" />
    <ProjectReference Include="..\AgentEval.Abstractions\AgentEval.Abstractions.csproj" />
    <ProjectReference Include="..\AgentEval.Core\AgentEval.Core.csproj" />
    <ProjectReference Include="..\AgentEval.Compliance.Core\AgentEval.Compliance.Core.csproj" />
    <ProjectReference Include="..\AgentEval.DataLoaders\AgentEval.DataLoaders.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Prompts\*.md" />
    <EmbeddedResource Include="Reporting\Schema\*.json" />
    <EmbeddedResource Include="Articles/Yaml/*.yaml" />
    <EmbeddedResource Include="DomainPacks\**\*.yaml" />
  </ItemGroup>
</Project>
