<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentEval.MissionControl</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Make Program accessible to WebApplicationFactory<Program> in tests. -->
    <InternalsVisibleTo Include="AgentEval.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentEval.Abstractions\AgentEval.Abstractions.csproj" />
    <ProjectReference Include="..\AgentEval.DataLoaders\AgentEval.DataLoaders.csproj" />
    <ProjectReference Include="..\AgentEval.Evals.Agentic\AgentEval.Evals.Agentic.csproj" />
    <ProjectReference Include="..\AgentEval.MAF\AgentEval.MAF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" />
  </ItemGroup>

  <!-- Phase-8 T2.7 — per-regulation evidence schemas. The schemas live in the
       compliance projects (which MC intentionally does NOT reference), so we
       link them in as MC-local embedded resources for the
       /api/v1/compliance/{regulation}/schema endpoint. The originals stay the
       single source of truth; this is a copy-in-the-binary, not a duplicate
       on disk. -->
  <ItemGroup>
    <EmbeddedResource Include="..\AgentEval.Compliance.Gdpr\Reporting\Schema\gdpr-evidence.schema.json"
                      LogicalName="AgentEval.MissionControl.Schemas.gdpr-evidence.schema.json"
                      Link="Schemas\gdpr-evidence.schema.json" />
    <EmbeddedResource Include="..\AgentEval.Compliance.EuAiAct\Reporting\Schema\eu-ai-act-evidence.schema.json"
                      LogicalName="AgentEval.MissionControl.Schemas.eu-ai-act-evidence.schema.json"
                      Link="Schemas\eu-ai-act-evidence.schema.json" />
  </ItemGroup>

  <!-- Plan-08 MC1.8.1: SPA build artefacts live at wwwroot/ (Vite writes here
       via outDir in src/AgentEval.MissionControl.Spa/vite.config.ts). They're
       gitignored — `npm run build` reproduces them locally. The Microsoft.NET.Sdk.Web
       SDK auto-publishes wwwroot/**/* via static web assets (a manifest is
       generated and served at runtime), so the standalone `dotnet run` path
       works without any explicit copy.

       Plan-08 MC1.7.1 (`agenteval mc serve`): the CLI spawns this project as a
       subprocess. `MapFallbackToFile("index.html")` resolves through the
       process's `WebRootPath = {ContentRootPath}/wwwroot/`, which means the
       subprocess's CWD must contain a wwwroot/ — not just the static-asset
       manifest. Copy the SPA build into bin/wwwroot/ for that path. -->
  <ItemGroup>
    <None Include="wwwroot\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
