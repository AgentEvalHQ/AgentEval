<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>AgentEval</RootNamespace>
  </PropertyGroup>

  <!-- Internals are exercised through public behavior, with one exception: ShadowJudgePump's consumer-starter
       seam. No public behavior can make a Task.Run consumer start AFTER DisposeAsync deterministically, and
       that ordering once lost every queued item unreported (see ShadowJudgeTests). -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentEval.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Gatekeeper/Schema/*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentEval.Abstractions/AgentEval.Abstractions.csproj" />
    <ProjectReference Include="../AgentEval.Core/AgentEval.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <!-- Security: keeps OpenTelemetry.Api at or above the patch that resolves GHSA-g94r-2vxg-569j,
         so the transitive version cannot fall below the fix (version and reason in Directory.Packages.props) -->
    <PackageReference Include="OpenTelemetry.Api" />
    <!-- NOTE: AgentEval.MAF does NOT reference Microsoft.Agents.AI.Workflows.Generators.
         That package provides source-generator support for [MessageHandler] attributed executor classes.
         If your consumer project uses [MessageHandler] executors, add the following to your own project
         (use the version pinned in Directory.Packages.props):
           <PackageReference Include="Microsoft.Agents.AI.Workflows.Generators" />
         This keeps the generator as a dev-time tooling dependency rather than a runtime transitive ref. -->
    <!-- Note: Microsoft.Agents.AI.OpenAI is intentionally omitted to keep this layer
         provider-agnostic. Consumers add it themselves for Azure/OpenAI scenarios.
         The .AsAIAgent() extension on AzureOpenAIClient requires that package. -->
    <!-- Light path: AgentEval metrics as MEAI IEvaluator -->
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
