<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    
    <!-- NuGet Package Info -->
    <PackageId>AgentEval</PackageId>
    <!-- Version is centralized in Directory.Build.props (single source of truth); the CLI inherits
         the same number so the two packages always release in lockstep. CI overrides via -p:PackageVersion. -->
    <Description>The comprehensive .NET evaluation toolkit for AI agents—tool usage validation, RAG quality metrics, stochastic evaluation, model comparison, and red team security testing. Built for Microsoft Agent Framework (MAF) with fluent assertion APIs.</Description>
    <PackageTags>ai;agent;evaluation;testing;benchmarking;maf;llm;openai;azure;rag;agentic;redteam;security;owasp;mitre;atlas;compliance;gdpr;eu-ai-act</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Release notes are intentionally version-agnostic — the per-version detail lives in
         CHANGELOG.md so this string never drifts out of date as the package Version is bumped. -->
    <PackageReleaseNotes>Per-version release notes: https://github.com/AgentEvalHQ/AgentEval/blob/main/CHANGELOG.md</PackageReleaseNotes>
    
    <!-- SourceLink: enables stepping into source code during debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Include sub-project DLLs in the NuGet package (they're internal, not separate packages) -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeSubProjectDlls</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <!-- MSBuild target: embed all ProjectReference DLLs into the NuGet lib/ folder -->
  <Target Name="IncludeSubProjectDlls" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
          Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'" />
    </ItemGroup>
  </Target>

  <!-- Expose internal members to test project -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentEval.Tests" />
  </ItemGroup>

  <!-- All 7 sub-projects: PrivateAssets=all embeds DLLs directly in the NuGet package
       (these are internal projects, NOT published as separate NuGet packages) -->
  <ItemGroup>
    <ProjectReference Include="../AgentEval.Abstractions/AgentEval.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="../AgentEval.Core/AgentEval.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="../AgentEval.Compliance.Core/AgentEval.Compliance.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="../AgentEval.DataLoaders/AgentEval.DataLoaders.csproj" PrivateAssets="all" />
    <ProjectReference Include="../AgentEval.Evals.Agentic/AgentEval.Evals.Agentic.csproj" PrivateAssets="all" />
    <ProjectReference Include="../AgentEval.Compliance.Gdpr/AgentEval.Compliance.Gdpr.csproj" PrivateAssets="all" />
    <ProjectReference Include="../AgentEval.Compliance.EuAiAct/AgentEval.Compliance.EuAiAct.csproj" PrivateAssets="all" />
    <ProjectReference Include="../AgentEval.Evals.Performance/AgentEval.Evals.Performance.csproj" PrivateAssets="all" />
    <ProjectReference Include="../AgentEval.Rendering.Pdf/AgentEval.Rendering.Pdf.csproj" PrivateAssets="all" />
    <ProjectReference Include="../AgentEval.MAF/AgentEval.MAF.csproj" PrivateAssets="all" />
    <ProjectReference Include="../AgentEval.Memory/AgentEval.Memory.csproj" PrivateAssets="all" />
    <ProjectReference Include="../AgentEval.RedTeam/AgentEval.RedTeam.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- External NuGet deps (explicit because PrivateAssets=all suppresses transitive propagation) -->
  <ItemGroup>
    <!-- Core -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.Numerics.Tensors" />
    <!-- DataLoaders -->
    <PackageReference Include="YamlDotNet" />
    <!-- Evals.Compliance.Gdpr -->
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="QuestPDF" />
    <!-- MAF -->
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <!-- Security: surface the OpenTelemetry.Api >=1.15.3 floor (GHSA-g94r-2vxg-569j) to
         downstream NuGet consumers. AgentEval.MAF references it directly, but PrivateAssets=all
         on the sub-project embeds the DLL without propagating the dependency, and CPM transitive
         pinning does not travel inside the .nupkg — so without this the package would otherwise
         let consumers resolve the vulnerable 1.15.0 transitively via Microsoft.Agents.AI. -->
    <PackageReference Include="OpenTelemetry.Api" />
    <!-- RedTeam -->
    <PackageReference Include="PdfSharp-MigraDoc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
