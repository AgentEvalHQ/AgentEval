<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- Bundled into the AgentEval umbrella NuGet via <ProjectReference PrivateAssets="all"/> in AgentEval/AgentEval.csproj.
         Not packed as a standalone package — consumers reach Memory types via the umbrella. -->
    <IsPackable>false</IsPackable>
    <RootNamespace>AgentEval</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentEval" />
    <InternalsVisibleTo Include="AgentEval.Tests" />
    <InternalsVisibleTo Include="AgentEval.Memory.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Report\report.html" />
    <EmbeddedResource Include="Report\archetypes.json" />
    <EmbeddedResource Include="Data\corpus\*.json" />
    <EmbeddedResource Include="Data\scenarios\*.json" />
    <!-- Small enough to embed, unlike the LongMemEval datasets: a consumer can run the
         time-grounded probe with no download and no path resolution. -->
    <EmbeddedResource Include="Data\longmemeval\timegrounded\*.json" />
    <!-- The TypedMemEval family is embedded-only by design: no dataset path knob exists, so
         "which corpus produced this number" is answered by the identifier and hash rather than
         by a path that may or may not still point at the same file. Each vertical ships its
         corpus plus a .meta.json sidecar carrying calibration and probe records. -->
    <EmbeddedResource Include="Data\typedmemeval\**\*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentEval.Abstractions/AgentEval.Abstractions.csproj" />
    <ProjectReference Include="../AgentEval.Core/AgentEval.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>