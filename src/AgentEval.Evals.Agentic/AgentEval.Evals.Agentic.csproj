    <IsPackable>false</IsPackable>
    <RootNamespace>AgentEval.Evals.Agentic</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentEval.Tests" />
    <InternalsVisibleTo Include="AgentEval.Rendering.PdfSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentEval.Rendering.Pdf/AgentEval.Rendering.Pdf.csproj" />
    <ProjectReference Include="..\AgentEval.Abstractions\AgentEval.Abstractions.csproj" />
    <ProjectReference Include="..\AgentEval.Core\AgentEval.Core.csproj" />
    <ProjectReference Include="..\AgentEval.DataLoaders\AgentEval.DataLoaders.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Prompts\**\*.md" />
    <EmbeddedResource Include="Reporting\Schema\*.json" />
    <EmbeddedResource Include="Adversarial\Resources\*.json" />
    <EmbeddedResource Include="EvaluatorCards\*.json" />
  </ItemGroup>

</Project>
