{
  "schemaVersion": "1.0",
  "key": "similarity",
  "name": "Similarity",
  "category": "rag",
  "version": "1.2.0",
  "description": "LLM judge of the semantic similarity between the agent response and a reference (ground-truth) answer.",
  "costTier": "Low",
  "higherIsBetter": true,
  "defaultThreshold": 0.7,
  "expectedInputs": [
    {
      "kind": "response",
      "key": "",
      "required": true,
      "description": "Agent response."
    },
    {
      "kind": "groundTruth",
      "key": "",
      "required": true,
      "description": "Reference answer, from EvalInput.GroundTruth (not a metadata entry). Without one the eval skips: not measured."
    }
  ],
  "recommendedVisualization": "histogram",
  "compatibleWith": [
    {
      "system": "foundry",
      "uri": "azureai://built-in/evaluators/similarity"
    }
  ],
  "links": {
    "documentation": "/docs/benchmarks/agentic/getting-started.md#similarity",
    "source": "src/AgentEval.Evals.Agentic/Quality/SimilarityEval.cs"
  }
}
