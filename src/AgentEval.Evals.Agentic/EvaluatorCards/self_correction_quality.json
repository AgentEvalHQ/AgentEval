  "key": "self_correction_quality",
  "name": "Self-Correction Quality",
  "category": "calibration",
  "version": "1.0.0",
  "description": "LLM judge assessing whether, after a user correction or pushback, the agent integrated the feedback correctly (not just capitulated, not stubbornly re-asserted).",
