  "higherIsBetter": true,
  "defaultThreshold": 0.75,
  "expectedInputs": [
    {
      "kind": "query",
      "key": "",
      "required": true,
      "description": "User correction message."
    },
    {
      "kind": "response",
      "key": "",
      "required": true,
      "description": "Agent response to the correction."
    },
    {
      "kind": "metadata",
      "key": "correction_turn",
      "required": true,
      "description": "The original turn being corrected \u2014 read via ConversationHistoryHelper.TryGetCorrectionTurn."
    }
  ],
  "recommendedVisualization": "histogram",
  "compatibleWith": [],
  "links": {
    "documentation": "/docs/benchmarks/agentic/getting-started.md#self-correction-quality",
