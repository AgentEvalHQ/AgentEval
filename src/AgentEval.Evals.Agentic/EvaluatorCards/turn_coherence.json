{
  "schemaVersion": "1.0",
  "key": "turn_coherence",
  "name": "Turn Coherence",
  "category": "multi-turn",
  "version": "1.0.0",
  "description": "LLM judge assessing whether the current turn response is coherent with the immediately preceding turn (response logically follows the previous user message + agent reply).",
  "costTier": "Medium",
  "higherIsBetter": true,
  "defaultThreshold": 0.8,
  "expectedInputs": [
    {
      "kind": "query",
      "key": "",
      "required": true,
      "description": "Current turn query."
    },
    {
      "kind": "response",
      "key": "",
      "required": true,
      "description": "Current turn response."
    },
    {
      "kind": "metadata",
      "key": "conversation_history",
      "required": true,
      "description": "Previous turn \u2014 read via ConversationHistoryHelper.FormatPreviousTurn."
    }
  ],
  "recommendedVisualization": "histogram",
  "compatibleWith": [],
  "links": {
    "documentation": "/docs/benchmarks/agentic/getting-started.md#turn-coherence",
    "source": "src/AgentEval.Evals.Agentic/MultiTurn/TurnCoherenceEval.cs"
  }
}
