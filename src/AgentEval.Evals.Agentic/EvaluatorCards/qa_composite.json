{
  "schemaVersion": "1.0",
  "key": "qa_composite",
  "name": "Q&A Composite",
  "category": "rag",
  "version": "1.2.0",
  "description": "Composite of 7 sub-LLM-judges (coherence, fluency, groundedness, relevance, completeness, similarity, response style) producing an aggregate Q&A quality score.",
  "costTier": "High",
  "higherIsBetter": true,
  "defaultThreshold": 0.7,
  "expectedInputs": [
    {
      "kind": "query",
      "key": "",
      "required": true,
      "description": "User query."
    },
    {
      "kind": "response",
      "key": "",
      "required": true,
      "description": "Agent response."
    },
    {
      "kind": "context",
      "key": "",
      "required": false,
      "description": "Optional retrieved context for groundedness."
    },
    {
      "kind": "groundTruth",
      "key": "",
      "required": false,
      "description": "Reference answer, from EvalInput.GroundTruth, for similarity and F1. Without one those two parts are not measured and the composite withholds its pass (warn), naming them."
    }
  ],
  "recommendedVisualization": "radar",
  "compatibleWith": [
    {
      "system": "foundry",
      "uri": "azureai://built-in/evaluators/qa"
    }
  ],
  "links": {
    "documentation": "/docs/benchmarks/agentic/getting-started.md#qa-composite",
    "source": "src/AgentEval.Evals.Agentic/Quality/QaCompositeEval.cs"
  }
}
