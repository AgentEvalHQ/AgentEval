{
  "schemaVersion": "1.0",
  "key": "response_completeness",
  "name": "Response Completeness",
  "category": "rag",
  "version": "1.2.0",
  "description": "LLM judge assessing whether the response covers all aspects of the user query (no missing parts).",
  "costTier": "Low",
  "higherIsBetter": true,
  "defaultThreshold": 0.7,
  "expectedInputs": [
    {
      "kind": "query",
      "key": "",
      "required": true,
      "description": "User query."
    },
    {
      "kind": "response",
      "key": "",
      "required": true,
      "description": "Agent response."
    },
    {
      "kind": "groundTruth",
      "key": "",
      "required": false,
      "description": "Optional reference answer, from EvalInput.GroundTruth: the expected facts are derived from it when supplied."
    }
  ],
  "recommendedVisualization": "histogram",
  "compatibleWith": [
    {
      "system": "foundry",
      "uri": "azureai://built-in/evaluators/response_completeness"
    }
  ],
  "links": {
    "documentation": "/docs/benchmarks/agentic/getting-started.md#response-completeness",
    "source": "src/AgentEval.Evals.Agentic/Quality/ResponseCompletenessEval.cs"
  }
}
