<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Phase 4 R4 review (2026-05-24): dropped net9 TFM. .NET 9 is STS, EOL May 2026;
         net8 LTS covers the wide install base; net10 is needed for mc serve. Two TFMs
         instead of three cuts the packed tool size by ~33% vs. the 3-TFM build. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgentEval.Cli</RootNamespace>
    <AssemblyName>AgentEval.Cli</AssemblyName>
    <Nullable>enable</Nullable>

    <!-- T1.5 (v1.1): publish as a global dotnet tool so users install with one command
         instead of cloning the repo and running from source. The tool multi-targets
         net8/net10 so install works on the widest set of .NET runtimes; the dotnet tool
         installer picks the highest compatible TFM. The mc serve subcommand is net10-only
         (Hot Chocolate 16 + MapStaticAssets); on net8 it prints a graceful "requires .NET
         10" message via the existing #if NET10_0_OR_GREATER guards. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agenteval</ToolCommandName>
    <PackageId>AgentEval.Cli</PackageId>
    <!-- Version is NOT hardcoded here — it is inherited from the single source of truth in
         Directory.Build.props (<Version>), so the CLI and the umbrella AgentEval package always
         share one number and release in lockstep. release.yml overrides both with
         -p:PackageVersion=<tag> on CI. -->
    <Description>AgentEval CLI — terminal + CI/CD entry point for the .NET evaluation toolkit. The agenteval init command bootstraps a .agenteval/ workspace; agenteval bench {gdpr|eu-ai-act|agentic|owasp|mitre|perf|longmemeval|memory} runs benchmark families; agenteval mc serve launches the local Mission Control portal (requires .NET 10); agenteval doctor verifies workspace integrity via canonical-JSON audit-chain hashing.</Description>
    <PackageTags>ai;agent;evaluation;cli;dotnet-tool;testing;benchmarking;gdpr;eu-ai-act;owasp;mitre;atlas;compliance</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Release notes are intentionally version-agnostic — the per-version detail lives in
         CHANGELOG.md so this string never drifts out of date as PackageVersion is bumped on CI. -->
    <PackageReleaseNotes>Install: dotnet tool install --global AgentEval.Cli --prerelease. Per-version release notes: https://github.com/AgentEvalHQ/AgentEval/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- snupkg symbol package for parity with the umbrella package. SourceLink lets users
         step INTO the CLI source while debugging from their own code that depends on it. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- CLI-specific package README (install + command surface), not the umbrella's root README. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentEval.Abstractions/AgentEval.Abstractions.csproj" />
    <ProjectReference Include="../AgentEval.DataLoaders/AgentEval.DataLoaders.csproj" />
    <ProjectReference Include="../AgentEval.Evals.Agentic/AgentEval.Evals.Agentic.csproj" />
    <ProjectReference Include="..\AgentEval.Compliance.Gdpr\AgentEval.Compliance.Gdpr.csproj" />
    <ProjectReference Include="..\AgentEval.Compliance.EuAiAct\AgentEval.Compliance.EuAiAct.csproj" />
    <ProjectReference Include="..\AgentEval.RedTeam\AgentEval.RedTeam.csproj" />
    <ProjectReference Include="..\AgentEval.RedTeam.Gatekeeper\AgentEval.RedTeam.Gatekeeper.csproj" />
    <!-- Phase 8 (v0.10.0-beta): CLI needs direct refs to Performance and Memory for
         BenchPerfCommand and to anchor their module initializers so registry entries
         appear in bench list / per-family help. -->
    <ProjectReference Include="..\AgentEval.Evals.Performance\AgentEval.Evals.Performance.csproj" />
    <ProjectReference Include="..\AgentEval.Memory\AgentEval.Memory.csproj" />
    <!-- T0.5 (v1.1): generic IEvalResultRenderer for OWASP / MITRE / Perf CLI report parity
         with GDPR / EuAiAct / Agentic. QuestPDF is bundled PrivateAssets in Rendering.Pdf. -->
    <ProjectReference Include="..\AgentEval.Rendering.Pdf\AgentEval.Rendering.Pdf.csproj" />
    <!-- v1.1 CLI consolidation: MAFEvaluationHarness is the runtime hosting the eval pipeline
         for the ported `agenteval eval` command (and only that command). Other commands talk
         to the harness via DataLoaders / Compliance / RedTeam abstractions and do not need
         this reference directly. -->
    <ProjectReference Include="..\AgentEval.MAF\AgentEval.MAF.csproj" />
  </ItemGroup>

  <!-- Plan-08 MC1.7.1: AgentEval.MissionControl is net10-only (Hot Chocolate 16
       + MapStaticAssets). The CLI is multi-targeted; only the net10 build
       references it. On net8 / net9 the `agenteval mc serve` subcommand prints
       a graceful "requires .NET 10" message and exits 2. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\AgentEval.MissionControl\AgentEval.MissionControl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <!-- Real Azure OpenAI judge for `agenteval bench ...` when env vars are set. -->
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The versioned gatekeeper verdict JSON schema ships beside the binary so non-.NET consumers can validate. -->
    <Content Include="Schemas/gatekeeper-verdict.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Grant the test assembly access to internal overloads used for testing -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AgentEval.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
