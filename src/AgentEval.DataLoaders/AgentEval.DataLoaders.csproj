<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>AgentEval</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentEval" />
    <InternalsVisibleTo Include="AgentEval.Tests" />
    <InternalsVisibleTo Include="AgentEval.Cli" />
    <!-- MNT-03: MC reuses WorkspaceRootDiscovery (Find + CanonicaliseExistingDirectory) instead of
         re-implementing the workspace-root walk and the workspace-path canonicalisation. -->
    <InternalsVisibleTo Include="AgentEval.MissionControl" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentEval.Abstractions/AgentEval.Abstractions.csproj" />
    <ProjectReference Include="../AgentEval.Core/AgentEval.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Output/Schema/v1/*.json" />
  </ItemGroup>

</Project>
