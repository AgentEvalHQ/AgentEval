<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests deliberately exercise [Experimental("AGENTEVAL_GATEKEEPER_PREVIEW001")]-marked Gatekeeper
         next-wave types (GatekeeperFleetHealthIndex, ICalibrationReportStore, JsonFileCalibrationReportStore,
         ToolResultSizeAnomalyGate) — the diagnostic is error-severity by design, so this suppression is a
         deliberate acknowledgment, not a blanket warning bypass. The same holds for the AgentHooks adapter, which is
         experimental as a whole assembly (AGENTEVAL_AGENTHOOKS_PREVIEW001). -->
    <!-- AgentEval's own use of its preview decision abstraction (DecisionsPreview): acknowledged here; consumers still see it. -->
    <NoWarn>$(NoWarn);AGENTEVAL_GATEKEEPER_PREVIEW001;AGENTEVAL_AGENTHOOKS_PREVIEW001;AGENTEVAL_DECISIONS_PREVIEW001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Agents.AI.A2A" PrivateAssets="all" />
    <!-- MAF's own AgentHooks HOST (alpha): proves GatekeeperInterceptor enforces inside it. Tests only. -->
    <PackageReference Include="Microsoft.Agents.AI.AgentHooks" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />

    <!-- Mvc.Testing 10.0 only available for net10.0; conditional so the test project
         can keep multi-targeting net8.0/net9.0/net10.0 for the rest of the suite. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Verify.Xunit" />
    <!-- Plan-13 T4.1b item 9: PDF parser used by tests to verify rendered PDF
         body contents (audit hash, truncation footer). PrivateAssets="all" so
         the dep stays scoped to the test surface and never leaks into product code. -->
    <PackageReference Include="PdfPig">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentEval.Abstractions\AgentEval.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.Core\AgentEval.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.DataLoaders\AgentEval.DataLoaders.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.Results\AgentEval.Results.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.Interop.AssertAi\AgentEval.Interop.AssertAi.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.MAF\AgentEval.MAF.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.MAF.CopilotStudio\AgentEval.MAF.CopilotStudio.csproj" />
    <!-- S1: the AGENT-HOOKS-0.1 interceptor adapter. Targets net8.0 only (the SDK ships lib/net8.0
         exclusively); net9.0/net10.0 test runs consume it through normal framework compatibility. -->
    <ProjectReference Include="..\..\src\AgentEval.MAF.AgentHooks\AgentEval.MAF.AgentHooks.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.RedTeam\AgentEval.RedTeam.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.RedTeam.Gatekeeper\AgentEval.RedTeam.Gatekeeper.csproj" />

    <!-- The memory-security test doubles live with the validation sample, out of the shipped package. -->
    <Compile Include="..\..\samples\AgentEval.Gatekeeper.Validation\MemorySecurityMockComponents.cs" Link="MAF\Gatekeeper\MemorySecurityMockComponents.cs" />
    <ProjectReference Include="..\..\src\AgentEval\AgentEval.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.Cli\AgentEval.Cli.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.Compliance.Gdpr\AgentEval.Compliance.Gdpr.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.Compliance.EuAiAct\AgentEval.Compliance.EuAiAct.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.Evals.Performance\AgentEval.Evals.Performance.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.Evals.Agentic\AgentEval.Evals.Agentic.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.Rendering.Pdf\AgentEval.Rendering.Pdf.csproj" />
    <!-- MissionControl is net10.0-only (server project); guard the reference so older
         test target frameworks can still build the rest of the suite. -->
    <ProjectReference Include="..\..\src\AgentEval.MissionControl\AgentEval.MissionControl.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Compliance/Gdpr/Calibration/Golden/*.jsonl" />
    <EmbeddedResource Include="Compliance/EuAiAct/Calibration/Golden/*.jsonl" />
    <EmbeddedResource Include="Agentic/Calibration/Golden/*.jsonl" />
    <EmbeddedResource Include="MAF/Gatekeeper/Fixtures/gatekeeper-replay-v1.jsonl"
                      LogicalName="AgentEval.Tests.GatekeeperReplayCorpus.jsonl" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the demo's pure aggregation helper into the test assembly. This keeps the live
         sample net10-only while exercising its statistics across every test target framework. -->
    <Compile Include="../../samples/AgentEval.Samples/PerformanceAndStatistics/ReliabilityRaceStatistics.cs"
             Link="Samples/ReliabilityRaceStatistics.cs" />
    <!-- AE-04. The end-to-end join test drives the SAMPLE FILE ITSELF rather than a copy of it, so
         "the smallest runnable example a newcomer can copy" and "the thing the test proves" cannot
         drift apart. Same pattern as ReliabilityRaceStatistics above. -->
    <Compile Include="../../samples/AgentEval.Samples/EvalJoin/01_EvalWithChanceFloor.cs"
             Link="Samples/01_EvalWithChanceFloor.cs" />

    <!-- 2.1: the TravelDemo deterministic eval, compiled here so its tests bind the shipped
         type rather than a copy. -->
    <Compile Include="../../samples/AgentEval.TravelDemo.Evals/Evals/BookFlightWasCalledEval.cs"
             Link="Samples/BookFlightWasCalledEval.cs" />

    <!-- 3.4: the benchmark sample, compiled here for the same reason as 01 above — the test
         drives the SAMPLE FILE, so the runnable example and the thing the test proves cannot
         drift apart. -->
    <Compile Include="../../samples/AgentEval.Samples/EvalJoin/02_DeterministicBenchmark.cs"
             Link="Samples/02_DeterministicBenchmark.cs" />

    <!-- P1 (ASSERT interop): the sample's logic, so the test runs what the sample runs. -->
    <Compile Include="../../samples/AgentEval.Samples/Interop/01_AssertInterop.Run.cs"
             Link="Samples/01_AssertInterop.Run.cs" />
  </ItemGroup>

</Project>
