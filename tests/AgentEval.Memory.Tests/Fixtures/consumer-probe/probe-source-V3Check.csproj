<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- This file is a RECORD of an external consumer's project, not a project of this
         repository: the README says "a standalone console app referencing the published
         AgentEval package. Point the PackageReference at the candidate version, dotnet run".
         An external consumer does not inherit our Directory.Packages.props, so it pins its own
         version — which is illegal under Central Package Management and made every repo-wide
         restore fail with NU1008, including the one GitHub's dependency-submission bot runs.
         Opting out here is not a workaround; it is the fixture telling the truth about what it
         is. The version pin below is the point of the record and must stay. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ⚠ DO NOT BUMP THIS TO TRACK THE LATEST RELEASE. 0.23.0-beta is not a dependency to
         keep current; it is the version the recorded output in this folder WAS PRODUCED AT.
         README.md describes within-question-probe.json as "full probe output on the five v3
         corpora (AgentEval 0.23.0-beta, published package)", so raising the pin without
         re-running the probe would leave the project claiming one version and the evidence
         beside it another. Re-point it when you RUN the probe against a candidate, and write
         the new output next to the new pin. Nothing builds or tests this file. -->
    <PackageReference Include="AgentEval" Version="0.23.0-beta" />
  </ItemGroup>
</Project>
