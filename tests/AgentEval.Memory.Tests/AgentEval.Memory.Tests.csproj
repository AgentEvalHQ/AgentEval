<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <!-- Question-id/type metadata only (no dataset content), in the real dataset's order, so
         sampling determinism is testable in CI where longmemeval_s_cleaned.json is gitignored. -->
    <Content Include="DataLoading\longmemeval-sampling-fixture.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The TypedMemEval judge calibration set and its recorded result. Embedded rather than copied
         so the tripwire reads the same bytes on every target framework and on any runner, whatever
         the working directory of the test host happens to be. -->
    <EmbeddedResource Include="Data\*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentEval.Memory\AgentEval.Memory.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.Core\AgentEval.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentEval.DataLoaders\AgentEval.DataLoaders.csproj" />
  </ItemGroup>

</Project>