{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentEval judge prompt pack v1",
  "description": "File metadata only. The loader also validates bounded UTF-8 Markdown, path containment, template slots, locale and reader compatibility; a JSON Schema pass alone is not execution approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "definitions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "definitions": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": { "$ref": "#/$defs/definition" }
    }
  },
  "$defs": {
    "markdown": {
      "type": "string", "minLength": 4, "maxLength": 512,
      "description": "Relative Markdown path beneath the manifest directory; traversal, drives and links are rejected by the loader.",
      "pattern": "\\.[mM][dD]$"
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    },
    "severityBand": {
      "type": "object", "additionalProperties": false,
      "required": ["atLeast", "severity"],
      "properties": {
        "atLeast": { "type": "number", "minimum": 0, "maximum": 1 },
        "severity": { "enum": ["none", "low", "medium", "high", "critical"] }
      }
    },
    "definition": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluatorKey", "id", "version", "locale", "responseContract", "scale", "systemFile", "userFile", "retryFile", "safetyFile"],
      "properties": {
        "evaluatorKey": { "type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
        "locale": { "type": "string", "minLength": 1, "maxLength": 64 },
        "responseContract": { "enum": ["criteriaV1", "rubricV1", "faithfulnessV1", "relevanceV1", "contextPrecisionV1", "contextRecallV1", "answerCorrectnessV1", "groundednessV1", "coherenceV1", "fluencyV1", "biasV1", "counterfactualBiasV1", "misinformationV1", "toxicityV1", "taskCompletionV1"] },
        "scale": { "enum": ["unit", "percent"] },
        "passAt": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
        "reviewAt": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "criteria": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/criterion" } },
        "severityBands": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/severityBand" } },
        "dataSlots": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "enum": ["input", "output", "context", "reference", "toolCalls", "toolDefinitions", "systemMessage", "expectedActions", "evaluatorNotes", "evaluatorPolicy"] } },
        "status": { "enum": ["draft", "authored", "calibrated"], "default": "draft" },
        "dimension": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
        "systemFile": { "$ref": "#/$defs/markdown" },
        "userFile": { "$ref": "#/$defs/markdown" },
        "retryFile": { "$ref": "#/$defs/markdown" },
        "safetyFile": { "$ref": "#/$defs/markdown" }
      },
      "allOf": [
        {
          "if": { "properties": { "responseContract": { "const": "criteriaV1" } }, "required": ["responseContract"] },
          "then": { "properties": { "scale": { "const": "percent" } } }
        }
      ]
    }
  }
}
